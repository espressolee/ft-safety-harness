{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ft-safety-harness/manifest-v1.schema.json",
  "title": "ft-safety-harness manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "arms"],
  "properties": {
    "schema_version": {
      "const": "ft-safety-harness.manifest.v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trials": {"type": "integer", "minimum": 1, "maximum": 1000},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600}
      }
    },
    "arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "command"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "role": {
            "enum": ["base", "candidate", "control", "fixture"]
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "cwd": {"type": "string", "minLength": 1},
          "environment": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          },
          "trials": {"type": "integer", "minimum": 1, "maximum": 1000},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600},
          "required_stdout_regex": {"type": "string", "minLength": 1},
          "required_stderr_regex": {"type": "string", "minLength": 1},
          "clean_exit_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer"}
          },
          "crash_exit_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "integer"}
          },
          "expectation": {
            "enum": [
              "all_clean",
              "at_least_one_crash",
              "all_timeout",
              "all_underdetermined",
              "all_harness_error",
              "none"
            ]
          }
        }
      }
    }
  }
}
